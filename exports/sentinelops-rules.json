[
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0101",
    "title": "Linux SSH Authentication Failure",
    "level": "medium",
    "description": "Detects a failed SSH authentication event in normalized Linux authentication telemetry.",
    "tags": [
      "attack.credential-access",
      "attack.t1110"
    ],
    "conditions": [
      {
        "field": "category",
        "operator": "equals",
        "value": "authentication"
      },
      {
        "field": "action",
        "operator": "equals",
        "value": "login_failed"
      }
    ]
  },
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0102",
    "title": "Windows Account Created",
    "level": "medium",
    "description": "Detects a Windows account creation event.",
    "tags": [
      "attack.persistence",
      "attack.t1136"
    ],
    "conditions": [
      {
        "field": "event_id",
        "operator": "equals",
        "value": "4720"
      },
      {
        "field": "action",
        "operator": "equals",
        "value": "account_created"
      }
    ]
  },
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0104",
    "title": "Windows Security Audit Log Cleared",
