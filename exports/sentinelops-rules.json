      },
      {
        "field": "action",
        "operator": "equals",
        "value": "audit_log_cleared"
      }
    ]
  },
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0106",
    "title": "Windows PowerShell Process Created",
    "level": "medium",
    "description": "Flags PowerShell process creation for analyst review; it does not imply malicious activity by itself.",
    "tags": [
      "attack.execution",
      "attack.t1059.001"
    ],
    "conditions": [
      {
        "field": "event_id",
        "operator": "equals",
        "value": "4688"
      },
      {
        "field": "process",
        "operator": "contains",
        "value": "powershell"
      }
    ]
  },
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0103",
    "title": "Windows Privileged Group Membership Changed",
    "level": "high",
    "description": "Detects a Windows security group membership addition that should be checked against an approved change.",
    "tags": [
      "attack.persistence",
      "attack.t1098"
    ],
    "conditions": [
      {
        "field": "action",
        "operator": "equals",
        "value": "group_member_added"
      },
      {
        "field": "event_id",
        "operator": "equals",
        "value": [
          "4728",
          "4732",
          "4756"
        ]
      }
    ]
  },
  {
    "id": "0d8b1f50-250a-4f6b-8a4f-218e2e9a0105",
    "title": "Windows Service Installed",
    "level": "high",
